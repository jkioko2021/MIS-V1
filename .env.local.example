# Template only. Run pnpm local:init to create .env.local with a unique secret.
# This file is loaded ONLY by the local:* commands, never by Replit workflows.
MIS_LOCAL_DEV=1
NODE_ENV=development
DATABASE_URL=postgresql://mis_local:REPLACE_WITH_YOUR_LOCAL_PASSWORD@127.0.0.1:5432/mis_local
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
# local:init writes an absolute path here; keep files outside the public web root.
MIS_LOCAL_DATA_DIR=REPLACE_WITH_ABSOLUTE_PATH_TO_PROJECT/.local-dev
MIS_LOGIN_OTP_USERNAME=admin
# Development-only addresses: mail is captured on disk, not sent externally.
MIS_LOGIN_OTP_EMAIL=admin@example.test
MIS_LOGIN_OTP_FROM=MIS Local <login@example.test>
MIS_EMAIL_FROM=MIS Local <notifications@example.test>
