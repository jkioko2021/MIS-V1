<table style="background-position: center center; border: thin solid #FF9900; background-color:#FFFFFF; outline:#cccccc Solid 1px; overflow:hidden; table-layout:fixed; position:inherit; top: 0px; left: 0px; width: inherit; height: 100%; color: #000000; clip: rect(auto, auto, auto, auto); right: 0px; bottom: 15px; "  
