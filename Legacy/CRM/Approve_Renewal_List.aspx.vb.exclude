    Protected Sub Page_Load(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.Load
        If Not IsPostBack Then
            SqlAction = "SELECT MIN(PERIOD_FROM)PERIOD_FROM,  MIN(PERIOD_TO)PERIOD_TO FROM MISREPORTS.[dbo].[TBL_MIS_RENEWAL_PROCESS] WHERE SIGNOFF_PERIOD=0"
            MyDatable = TryCast(MyDBAction.DBAction(SqlAction, DataManagement.DBActionType.DataTable), Data.DataTable)
            If MyDatable.Rows.Count > 0 Then
                Session("PERIOD_FROM") = CDate(MyDatable.Rows(0).Item("PERIOD_FROM")).ToString("yyyy-MM-dd")
                Session("PERIOD_TO") = CDate(MyDatable.Rows(0).Item("PERIOD_TO")).ToString("yyyy-MM-dd") ' MyDatable.Rows(0).Item("DATE_TO").ToString()

                dtmonthfr.DbSelectedDate = Session("PERIOD_FROM")
                dtmonthto.DbSelectedDate = Session("PERIOD_TO")

            End If
            Session("Month") = Nothing
            Session("EXCEL") = Nothing
            Session("DAD_5") = Nothing
            Load_Grid()

            'BTNEXCEL.Enabled = False
        End If
    End Sub

    Protected Sub GDSEARCH1_PageIndexChanged(ByVal sender As Object, ByVal e As Telerik.Web.UI.GridPageChangedEventArgs) Handles GDSEARCH.PageIndexChanged
        GDSEARCH.CurrentPageIndex = e.NewPageIndex
        GDSEARCH.DataSource = Session("DAD_5")
        GDSEARCH.DataBind()
    End Sub
    Protected Sub GDSEARCH_1_PageIndexChanged(ByVal sender As Object, ByVal e As Telerik.Web.UI.GridPageChangedEventArgs) Handles GDSEARCH_1.PageIndexChanged
        GDSEARCH_1.CurrentPageIndex = e.NewPageIndex
        GDSEARCH_1.DataSource = Session("DAD_5_1")
        GDSEARCH_1.DataBind()
    End Sub


    Private Sub ExporttoExcel(ByVal table As System.Data.DataTable, ByVal FileName As String)

        'Export the Columns to excel file

        Dim attachment As String = "attachment; filename=" & FileName & ".xls"
        Response.ClearContent()
        Response.AddHeader("content-disposition", attachment)
        Response.ContentType = "application/vnd.ms-excel"
        Dim tab As String = ""

        For Each dc As DataColumn In table.Columns
            Response.Write(tab + dc.ColumnName)
            tab = vbTab
        Next

        Response.Write(vbLf)

        Dim i As Integer
        For Each dr As DataRow In table.Rows
            tab = ""
            For i = 0 To table.Columns.Count - 1
                Response.Write(tab & dr(i).ToString())
                tab = vbTab
            Next
            Response.Write(vbLf)
        Next
        Response.End()
        '

    End Sub

  
    Private Sub UpdateRecord(ByVal sqlAction As String)
        Dim MySmsObject As New DataManagement
        MySmsObject.DBAction(sqlAction, DataManagement.DBActionType.Update)

    End Sub

    Protected Sub cmdview_Click(ByVal sender As Object, ByVal e As System.EventArgs) Handles cmdview.Click

        Dim MyDatable As New Data.DataTable
        Session("DAD_5") = Nothing



    End Sub
    Protected Sub BTNEXCEL_Click(ByVal sender As Object, ByVal e As System.EventArgs) Handles BTNEXCEL.Click
        Dim Str As String = "" : Dim Mytable As DataTable = Nothing
        Dim Reportname As String


        Session("EXCEL") = "TO EXCEL"

        Reportname = "Renewal List-& " & dtmonthfr.DbSelectedDate & ""
        SqlAction = "SELECT T.POLICY_CODE, T.PROPOSER_DISPLAY_NAME, T.DISPLAY_MEMBERSHIP_NO,T.FAMILY_NO, T.MEMBER_NAME, T.RELATION, T.SCHEME_NAME, T.FAMILY_SHARED, T.OP_BENEFIT,T.MEMBER_BIRTH_DATE, T.MEMBER_ADMINISTRATIVE_SEX, T.POLICY_VALID_FROM, T.POLICY_VALID_UPTO,T.AGENT, T.PROPOSER_PRI_ADD_LINE1,+''''+ T.MOBILE_NO, T.AGE_AT_RENEWAL, T.CATEGORY, T.OP_LIMIT,T.OP_PREMIUM, T.IP_PREMIUM, T.PA, T.NCD, T.LEVIES, T.TOTAL_PREMIUM,T.IS_LOADING, V.UM_MANAGER, V.UNIT_NAME, V.BRANCH_NAME, V.REGION_NAME,R.RE_NAME FROM   CRM.[dbo].TBL_MIS_RENEWAL_UPLOAD T INNER JOIN  COMMISSION.dbo.VW_MIS_AGENTS_LISTING V ON T.AGENT_ID = (V.USER_ID) LEFT OUTER JOIN   dbo.TBL_MIS_CRM_RMS R ON T.RMS_CODE = (R.RE_CODE)      WHERE T.POLICY_VALID_FROM BETWEEN '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "' AND T.APPROVED=0"
        Mytable = TryCast(MyDBAction.DBAction(SqlAction, DataManagement.DBActionType.DataTable), Data.DataTable)
        If Mytable.Rows.Count > 0 Then
            Mytable = TryCast(MyDBAction.DBAction(SqlAction, DataManagement.DBActionType.DataTable), Data.DataTable)
            Session("Mytable") = (Mytable)
            Session("Reportname") = Reportname
            ResponseHelper.Redirect("Reports.aspx", "_blank", "")
            Mytable = Nothing
            System.Threading.Thread.Sleep(5000)

        End If



    End Sub

    

