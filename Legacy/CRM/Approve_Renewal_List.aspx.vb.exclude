    Protected Sub RadButton1_Click(ByVal sender As Object, ByVal e As System.EventArgs) Handles RadButton1.Click
        If chksign.Checked = True Then
            Dim MailSent As Boolean = False
            Dim s As Date
            Dim msg As Integer = 0
            Try

                UpdateRecord("UPDATE CRM.dbo.[TBL_MIS_RENEWAL_PROPOSER_LIST] SET [APPROVED]=1 ,[APPROVED_BY]='" & Session("username") & "',[APPROVE_DATE]='" & CDate(Date.Now()).ToString("yyyy-MM-dd") & "' where PERIOD_FROM>= '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND PERIOD_FROM<= '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "' AND APPROVED=0")
                UpdateRecord("UPDATE CRM.dbo.[TBL_MIS_RENEWAL_UPLOAD] SET [APPROVED]=1 ,[APPROVED_BY]='" & Session("username") & "' where [POLICY_VALID_FROM]>= '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND [POLICY_VALID_FROM]<= '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "'  AND APPROVED=0")
                UpdateRecord("UPDATE MISREPORTS.dbo.[TBL_MIS_RENEWAL_LIST] SET [APPROVED]=1,APPROVED_BY='" & Session("username") & "',APPROVE_DATE='" & CDate(Date.Now()).ToString("yyyy-MM-dd") & "'  where PERIOD_FROM>= '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND PERIOD_FROM<= '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "' AND APPROVED=0 AND VALIDATED=1 AND ON_HOLD=0")

                MyDBAction.RENEWAL_EMAIL_DISPATCH(CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd"), CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd"))
                UpdateRecord("UPDATE CRM.dbo.[TBL_MIS_RENEWAL_UPLOAD] SET POSTED=1 where [POLICY_VALID_FROM]>= '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND [POLICY_VALID_FROM]<= '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "'  AND APPROVED=1")
               

                lblerr.Text = "Approved and saved successfully"
                'MailSent = SendReminder("Pricing Team", Session("Path"), "Quotations@aar.co.ke", "mwangeci@aar.co.ke", msg)
                Load_Grid()
            Catch ex As Exception
                lblerr.Text = ex.Message
            End Try

        End If
    End Sub

    Public Sub Load_Grid()
        SqlAction = "SELECT [POLICY_CODE],[PROPOSER_DISPLAY_NAME],[DISPLAY_MEMBERSHIP_NO],[FAMILY_NO],[MEMBER_NAME],[RELATION],[SCHEME_NAME],[FAMILY_SHARED],[OP_BENEFIT],[MEMBER_BIRTH_DATE],[MEMBER_ADMINISTRATIVE_SEX],[POLICY_VALID_FROM],[POLICY_VALID_UPTO],[AGENT],[PROPOSER_PRI_ADD_LINE1],[AGE_AT_RENEWAL],[CATEGORY],[OP_LIMIT],[OP_PREMIUM],[IP_PREMIUM],[PA],[NCD],[LEVIES],[TOTAL_PREMIUM],[IP_PREM_SILVERPLUS],[LEVIES_S],[SILVERPLUS_PREMIUM] FROM [COM_ACTIVITIES_DB].[dbo].[TBL_MIS_RENEWAL_UPLOAD] WHERE POLICY_VALID_FROM>= '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND POLICY_VALID_FROM<= '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "' AND Verified=0 AND APPROVED=1"
        MyDatable = TryCast(MyDBAction.DBAction(SqlAction, DataManagement.DBActionType.DataTable), Data.DataTable)

        If MyDatable.Rows.Count > 0 Then
            GDSEARCH_1.DataSource = MyDatable
            GDSEARCH_1.DataBind()
            Session("DAD_5") = MyDatable

            txttotal_1.Text = Convert.ToInt32(MyDatable.Compute("SUM(TOTAL_PREMIUM)", String.Empty))
            'txttotalplus.Text = Convert.ToInt32(MyDatable.Compute("sum(SILVERPLUS_PREMIUM)", String.Empty))
            MyDatable = Nothing

            BTNEXCEL.Enabled = True
        Else
            GDSEARCH_1.DataSource = MyDatable
            GDSEARCH_1.DataBind()
        End If


        SqlAction = "SELECT [POLICY_CODE],[PROPOSER_DISPLAY_NAME],[DISPLAY_MEMBERSHIP_NO],[FAMILY_NO],[MEMBER_NAME],[RELATION],[SCHEME_NAME],[FAMILY_SHARED],[OP_BENEFIT],[MEMBER_BIRTH_DATE],[MEMBER_ADMINISTRATIVE_SEX],[POLICY_VALID_FROM],[POLICY_VALID_UPTO],[AGENT],[PROPOSER_PRI_ADD_LINE1],[AGE_AT_RENEWAL],[CATEGORY],[OP_LIMIT],[OP_PREMIUM],[IP_PREMIUM],[PA],[NCD],[LEVIES],[TOTAL_PREMIUM],[IP_PREM_SILVERPLUS],[LEVIES_S],[SILVERPLUS_PREMIUM] FROM CRM.[dbo].[TBL_MIS_RENEWAL_UPLOAD] WHERE POLICY_VALID_FROM>= '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND POLICY_VALID_FROM<= '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "' AND APPROVED=0"
        MyDatable = TryCast(MyDBAction.DBAction(SqlAction, DataManagement.DBActionType.DataTable), Data.DataTable)

        If MyDatable.Rows.Count > 0 Then
            GDSEARCH.DataSource = MyDatable
            GDSEARCH.DataBind()
            Session("DAD_5") = MyDatable

            txttotal.Text = Convert.ToInt32(MyDatable.Compute("SUM(TOTAL_PREMIUM)", String.Empty))
            'txttotalplus.Text = Convert.ToInt32(MyDatable.Compute("sum(SILVERPLUS_PREMIUM)", String.Empty))
            MyDatable = Nothing

            BTNEXCEL.Enabled = True
        Else
            GDSEARCH.DataSource = MyDatable
            GDSEARCH.DataBind()
        End If
    End Sub

    Protected Sub RadButton2_Click(sender As Object, e As System.EventArgs) Handles RadButton2.Click
        Try
            lblerr.Text = ""
            If chkver.Checked = True Then
                UpdateRecord("UPDATE  [COM_ACTIVITIES_DB].[dbo].[TBL_MIS_RENEWAL_UPLOAD] SET [Verified]=1,Verified_BY='" & Session("username") & "' where POLICY_VALID_FROM>= '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND POLICY_VALID_FROM<= '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "' AND Verified=0")
                UpdateRecord("UPDATE MISREPORTS.[dbo].[TBL_MIS_RENEWAL_PROCESS] SET  [APPROVAL]=1, [SIGNOFF_PERIOD]=1,EMAIL_NOTIFICATION=1 WHERE    PERIOD_FROM = '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND PERIOD_TO= '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "'")
                'MailSent = SendLoginDetails(Session("EMPNAME"), Session("Path"), Session("RecepientEmail"), Session("agentEmail"))
                lblerr.Text = "Sign-off & Verification done successfully"
                SqlAction = "SELECT MIN(PERIOD_FROM)PERIOD_FROM,  MIN(PERIOD_TO)PERIOD_TO FROM MISREPORTS.[dbo].[TBL_MIS_RENEWAL_PROCESS] WHERE SIGNOFF_PERIOD=0"
                MyDatable = TryCast(MyDBAction.DBAction(SqlAction, DataManagement.DBActionType.DataTable), Data.DataTable)
                If MyDatable.Rows.Count > 0 Then
                    dtmonthfr.DbSelectedDate = CDate(MyDatable.Rows(0).Item("PERIOD_FROM")).ToString("yyyy-MM-dd")
                    dtmonthto.DbSelectedDate = CDate(MyDatable.Rows(0).Item("PERIOD_TO")).ToString("yyyy-MM-dd") ' MyDatable.Rows(0).Item("DATE_TO").ToString()

                End If

            End If

            Load_Grid()

        Catch ex As Exception
            lblerr.Text = ex.Message
        End Try
    End Sub

    Protected Sub BTNEXCEL0_Click(sender As Object, e As System.EventArgs) Handles BTNEXCEL0.Click
        Dim Str As String = "" : Dim Mytable As DataTable = Nothing
        Dim Reportname As String


        Session("EXCEL") = "TO EXCEL"

        Reportname = "Renewal List-& " & dtmonthfr.DbSelectedDate & ""
        SqlAction = "SELECT T.POLICY_CODE, T.PROPOSER_DISPLAY_NAME, T.DISPLAY_MEMBERSHIP_NO,T.FAMILY_NO, T.MEMBER_NAME, T.RELATION, T.SCHEME_NAME, T.FAMILY_SHARED, T.OP_BENEFIT,T.MEMBER_BIRTH_DATE, T.MEMBER_ADMINISTRATIVE_SEX, T.POLICY_VALID_FROM, T.POLICY_VALID_UPTO,T.AGENT, T.PROPOSER_PRI_ADD_LINE1,+''''+ T.MOBILE_NO, T.AGE_AT_RENEWAL, T.CATEGORY, T.OP_LIMIT,T.OP_PREMIUM, T.IP_PREMIUM, T.PA, T.NCD, T.LEVIES, T.TOTAL_PREMIUM,T.IS_LOADING, V.UM_MANAGER, V.UNIT_NAME, V.BRANCH_NAME, V.REGION_NAME,R.RE_NAME FROM   COM_ACTIVITIES_DB.[dbo].TBL_MIS_RENEWAL_UPLOAD T INNER JOIN  [COMMISSION].dbo.VW_MIS_AGENTS_LISTING V ON T.AGENT_ID = (V.USER_ID) LEFT OUTER JOIN   CRM.dbo.TBL_MIS_CRM_RMS R ON T.RMS_CODE = (R.RE_CODE)      WHERE T.POLICY_VALID_FROM BETWEEN '" & CDate(dtmonthfr.SelectedDate).ToString("yyyy-MM-dd") & "' AND '" & CDate(dtmonthto.SelectedDate).ToString("yyyy-MM-dd") & "' AND T.Verified=0"
        Mytable = TryCast(MyDBAction.DBAction(SqlAction, DataManagement.DBActionType.DataTable), Data.DataTable)
        If Mytable.Rows.Count > 0 Then
            Mytable = TryCast(MyDBAction.DBAction(SqlAction, DataManagement.DBActionType.DataTable), Data.DataTable)
            Session("Mytable") = (Mytable)
            Session("Reportname") = Reportname
            ResponseHelper.Redirect("Reports.aspx", "_blank", "")
            Mytable = Nothing
            System.Threading.Thread.Sleep(5000)

        End If
    End Sub
End Class
