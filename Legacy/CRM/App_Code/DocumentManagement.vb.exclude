        Public Function AddCharges(ByVal MyAccountNumber As String, ByVal FTInterAcct As Double, ByVal FTIntercust As Double, _
        ByVal FTInterAcctLocal As Double, ByVal FTInternational As Double, ByVal Bill As Double, ByVal ATM As Double, _
        ByVal BankersCheque As Double, ByVal CooporateCheque As Double, ByVal SaloPayment As Double, ByVal percentage As Boolean, _
        ByVal percentOWN As Boolean, ByVal PercentLocalB As Boolean, ByVal PercentWithinB As Boolean, ByVal PercentSalo As Boolean, _
        ByVal Suppliercharge As Double, ByVal supPercent As Boolean, ByVal FtOwnAccMin As Double, ByVal FtOwnAccMax As Double, _
        ByVal LocalBanksMin As Double, ByVal LocalBanksMax As Double, ByVal AbcMin As Double, ByVal AbcMax As Double, ByVal utility As Double) As Integer

            Dim MyBillPaymentID As Int32 = 0


            Dim EnctryptionAlgorith As String = "rijndael"
            Dim CryptographyFactory As New FinpayiSecurity.CryptoFactory()
            Dim Cryptographer As FinpayiSecurity.ICrypto = CryptographyFactory.MakeCryptographer(EnctryptionAlgorith)

            Dim DecryptedStr As String = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("FINMIS3").ConnectionString)

            Dim myConnection As New SqlConnection(DecryptedStr)
            myConnection.Open()
            Dim myCommand As New SqlCommand("Add_Charges", myConnection)

            Try



                With myCommand
                    .CommandType = Data.CommandType.StoredProcedure
                    .Parameters.Add("@ChargeId", Data.SqlDbType.Real).Direction = Data.ParameterDirection.Output
                    .Parameters.Add("@SourceAccountNumber", Data.SqlDbType.VarChar, 50).Value = MyAccountNumber
                    .Parameters.Add("@FTInterAcct", Data.SqlDbType.Money).Value = FTInterAcct
                    .Parameters.Add("@FTIntercust", Data.SqlDbType.Money).Value = FTIntercust
                    .Parameters.Add("@FTInterAcctLocal", Data.SqlDbType.Money).Value = FTInterAcctLocal
                    .Parameters.Add("@FTInternational", Data.SqlDbType.Money).Value = FTInternational
                    .Parameters.Add("@Bill", Data.SqlDbType.Money).Value = Bill
                    .Parameters.Add("@ATM", Data.SqlDbType.Money).Value = ATM
                    .Parameters.Add("@BankersCheque ", Data.SqlDbType.Money).Value = BankersCheque
                    .Parameters.Add("@CooporateCheque ", Data.SqlDbType.Money).Value = CooporateCheque
                    .Parameters.Add("@SalaryPY ", Data.SqlDbType.Money).Value = SaloPayment
                    .Parameters.Add("@percentage  ", Data.SqlDbType.Bit).Value = percentage
                    .Parameters.Add("@FTOwnPercentage  ", Data.SqlDbType.Bit).Value = percentOWN
                    .Parameters.Add("@FTLocalBankPercent  ", Data.SqlDbType.Bit).Value = PercentLocalB
                    .Parameters.Add("@FTWithinPercent  ", Data.SqlDbType.Bit).Value = PercentWithinB
                    .Parameters.Add("@SalaryPercent  ", Data.SqlDbType.Bit).Value = PercentSalo
                    .Parameters.Add("@SupplierPY  ", Data.SqlDbType.Money).Value = Suppliercharge
                    .Parameters.Add("@SupplierPercent  ", Data.SqlDbType.Bit).Value = supPercent

                    'added
                    .Parameters.Add("@FtOwnAccMin ", Data.SqlDbType.Money).Value = FtOwnAccMin
                    .Parameters.Add("@FtOwnAccMax ", Data.SqlDbType.Money).Value = FtOwnAccMax
                    ' LocalBanksMax()
                    .Parameters.Add("@FTIntercustMin  ", Data.SqlDbType.Money).Value = LocalBanksMin
                    .Parameters.Add("@FTIntercustMax  ", Data.SqlDbType.Money).Value = LocalBanksMax

                    'AbcMax
                    .Parameters.Add("@FTInterAcctLocalMin  ", Data.SqlDbType.Money).Value = AbcMin
                    .Parameters.Add("@FTInterAcctLocalMax  ", Data.SqlDbType.Money).Value = AbcMax

                    .Parameters.Add("@utility ", Data.SqlDbType.Money).Value = utility

                    .ExecuteNonQuery()
                    MyBillPaymentID = .Parameters.Item("@ChargeId").Value.ToString
                End With

                myConnection.Close()

                Return MyBillPaymentID

            Catch ex As Exception

            End Try

        End Function

