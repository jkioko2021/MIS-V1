        Public Function AddTransactionsForex(ByVal MyTransType As String, ByVal MyTerminal As String, _
        ByVal Myusername As String, ByVal Mysessionid As String) As Integer

            Dim myID As Double = 0
            Dim EnctryptionAlgorith As String = "rijndael"
            Dim CryptographyFactory As New FinpayiSecurity.CryptoFactory()
            Dim Cryptographer As FinpayiSecurity.ICrypto = CryptographyFactory.MakeCryptographer(EnctryptionAlgorith)

            Dim DecryptedStr As String = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("FINMIS3").ConnectionString)

            Dim myConnection As New SqlConnection(DecryptedStr)
            myConnection.Open()
            Dim myCommand As New SqlCommand("Add_Transactions_Forex", myConnection)

            Try
                With myCommand
                    .CommandType = Data.CommandType.StoredProcedure
                    .Parameters.Add("@ID", Data.SqlDbType.Real).Direction = Data.ParameterDirection.Output
                    .Parameters.Add("@TransactionType", Data.SqlDbType.VarChar, 20).Value = MyTransType
                    .Parameters.Add("@Terminal", Data.SqlDbType.VarChar, 50).Value = MyTerminal
                    .Parameters.Add("@Username", Data.SqlDbType.VarChar, 50).Value = Myusername
                    .Parameters.Add("@sessionid", Data.SqlDbType.VarChar, 50).Value = Mysessionid
                    .ExecuteNonQuery()
                    myID = .Parameters.Item("@ID").Value
                End With

                myConnection.Close()

                Return myID

            Catch ex As Exception

            End Try

        End Function
