            Try
                With myCommand
                    .CommandType = Data.CommandType.StoredProcedure
                    .Parameters.Add("@SignatoryID", Data.SqlDbType.Real).Value = MySignatoryID
                    .Parameters.Add("@Activated", Data.SqlDbType.Int).Value = 0
