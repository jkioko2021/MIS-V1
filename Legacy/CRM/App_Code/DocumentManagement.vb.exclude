        Public Interface ICrypto
            Function BlockSize() As Integer
            Function KeySize() As Integer

            Function Encrypt(ByVal data As String) As String
            Function Decrypt(ByVal data As String) As String
        End Interface
        Public Class CryptoFactory
            Public Function MakeCryptographer(ByVal type As String) As ICrypto
                Select Case type.ToLower
                    Case "des"
                        'Return New DES()
                    Case "tripledes"
                        'Return New TripleDES()
                    Case "rijndael"
                        Return New Rijndael()
                    Case Else
                        'Return New TripleDES()
                End Select
            End Function
        End Class
        Public Class Rijndael
            Implements ICrypto

            ' The key and initialization vector : change them for your application
            Private _key() As Byte = {132, 42, 53, 124, 75, 56, 87, 38, 9, 10, 161, 132, 183, _
        91, 105, 16, 117, 218, 149, 230, 221, 212, 235, 64}
            Private _iv() As Byte = {83, 71, 26, 58, 54, 35, 22, 11, 83, 71, 26, 58, 54, 35, 22, 11}

            ' returns the default size, in bits of the iv
            Public Function BlockSize() As Integer Implements ICrypto.BlockSize
                Dim aes As New RijndaelManaged()

                Return aes.BlockSize
            End Function

            ' returns the default size, in bits of the key
            Public Function KeySize() As Integer Implements ICrypto.KeySize
                Dim aes As New RijndaelManaged()

                Return aes.KeySize
            End Function

            ' decrypts a string that was encrypted using the Encrypt method
            Public Function Decrypt(ByVal data As String) As String Implements ICrypto.Decrypt
                Try
                    Dim inBytes() As Byte = Convert.FromBase64String(data)
                    Dim mStream As New MemoryStream(inBytes, 0, inBytes.Length) ' instead of writing the decrypted text

                    Dim aes As New RijndaelManaged()
                    Dim cs As New CryptoStream(mStream, aes.CreateDecryptor(_key, _iv), CryptoStreamMode.Read)

                    Dim sr As New StreamReader(cs)

                    Return sr.ReadToEnd()
                Catch ex As Exception
                    Throw ex
                End Try
            End Function

            ' Encrypts a given string
            Public Function Encrypt(ByVal data As String) As String Implements ICrypto.Encrypt
                Try
                    Dim utf8 As New UTF8Encoding
                    Dim inBytes() As Byte = utf8.GetBytes(data) ' ascii encoding uses 7 
                    'bytes for characters whereas the encryption uses 8 bytes, thus we use utf8
                    Dim ms As New MemoryStream() 'instead of writing the encrypted 
                    'string to a filestream, I will use a memorystream

                    Dim aes As New RijndaelManaged()
                    Dim cs As New CryptoStream(ms, aes.CreateEncryptor(_key, _iv), CryptoStreamMode.Write)

                    cs.Write(inBytes, 0, inBytes.Length) ' encrypt
                    cs.FlushFinalBlock()

                    Return Convert.ToBase64String(ms.GetBuffer(), 0, ms.Length)
                Catch ex As Exception
                    Throw ex
                End Try
            End Function
        End Class


    End Class

    ''---This class is 4 encrypting/decrypting system settings - 11th April 2011
    Public Class SysSettsEncryption
        Public Function EncryptSHA(ByVal Data As String) As String
            Dim shaM As New System.Security.Cryptography.SHA1Managed
            Convert.ToBase64String(shaM.ComputeHash(Encoding.ASCII.GetBytes(Data)))
            Dim eNC_data() As Byte = ASCIIEncoding.UTF32.GetBytes(Data)
            Dim eNC_str As String = Convert.ToBase64String(eNC_data)
            EncryptSHA = eNC_str
        End Function

        Public Function DecryptSHA(ByVal Data As String) As String
            Try
                Dim dEC_data() As Byte = Convert.FromBase64String(Trim(Data))
                Dim dEC_Str As String = ASCIIEncoding.UTF32.GetString(dEC_data)
                DecryptSHA = dEC_Str
            Catch ex As Exception
                Return ex.Message
            End Try
        End Function

    End Class

    Public Class DataManagement
        Public Enum DBActionType
            DataReader = 1
            Dataset = 2
            Scalar = 3
            Delete = 4
            Insert = 5
            Update = 6
            DataTable = 7
            ODBCDataReader = 8
            ODBCScalar = 9
            ODBCDataTable = 10
            OracleDataReader = 11
            OracleScalar = 12
            OracleDataTable = 13
        End Enum
        Public Function DBAction(ByVal MyDBAction As Object, ByVal ActionType As DBActionType) As Object
            DBAction = Nothing
            Dim DecryptedStr As String = Nothing

            Dim EnctryptionAlgorith As String = "rijndael"
            Dim CryptographyFactory As New FinpayiSecurity.CryptoFactory()
            Dim Cryptographer As FinpayiSecurity.ICrypto = CryptographyFactory.MakeCryptographer(EnctryptionAlgorith)

            DecryptedStr = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("FINMIS3").ConnectionString)

            Dim myConnection As New SqlConnection(DecryptedStr)

            Dim myODBCConnection As New OdbcConnection
            Dim MyOracleConnection As New OracleConnection


            Dim MyReader As SqlDataReader = Nothing
            Dim MyReaderODBC As OdbcDataReader = Nothing
            Dim MyOracleReaderReader As OracleDataReader = Nothing

            Try

                myConnection.Open()


                Select Case ActionType
                    Case DBActionType.DataReader ' 1
                        myODBCConnection = Nothing
                        MyOracleConnection = Nothing

                        Dim myCommand As New SqlCommand(MyDBAction.ToString, myConnection)
                        MyReader = myCommand.ExecuteReader(Data.CommandBehavior.CloseConnection)

                        Return MyReader

                    Case DBActionType.Dataset '2
                        myODBCConnection = Nothing
                        MyOracleConnection = Nothing

                        Dim MyAdpater As New SqlDataAdapter(MyDBAction.ToString, myConnection)
                        Dim myDataSet As New Data.DataSet
                        MyAdpater.Fill(myDataSet)

                        myConnection.Close()

                        Return myDataSet
                    Case DBActionType.Scalar ' 3
                        myODBCConnection = Nothing
                        MyOracleConnection = Nothing

                        Dim myCommand As New SqlCommand(MyDBAction.ToString, myConnection)
                        Dim ScalarItem As Object = myCommand.ExecuteScalar

                        myConnection.Close()

                        Return ScalarItem

                    Case 4, 5, 6
                        Dim myCommand As New SqlCommand(MyDBAction.ToString, myConnection)
                        myCommand.ExecuteNonQuery()
                        myConnection.Close()

                    Case DBActionType.DataTable ' 7
                        myODBCConnection = Nothing
                        MyOracleConnection = Nothing

                        Dim MyAdpater As New SqlDataAdapter(MyDBAction.ToString, myConnection)
                        Dim MyDataTable As New Data.DataTable
                        MyAdpater.Fill(MyDataTable)
                        myConnection.Close()

                        Return MyDataTable

                    Case DBActionType.ODBCDataReader ' 8
                        myODBCConnection = Nothing


                        myODBCConnection.ConnectionString = WebConfigurationManager.ConnectionStrings("DeltaConnection").ConnectionString
                        myODBCConnection.Open()

                        'Dim MyODBCAdapter As New OdbcDataAdapter(MyDBAction.ToString, myODBCConnection)
                        'Dim MyDataTable As New Data.DataTable
                        'MyODBCAdapter.Fill(MyDataTable)
                        'myODBCConnection.Close()

                        Dim myCommand As New OdbcCommand(MyDBAction.ToString, myODBCConnection)
                        MyReaderODBC = myCommand.ExecuteReader(Data.CommandBehavior.CloseConnection)

                        Return MyReaderODBC

                    Case DBActionType.ODBCScalar ' 9

                        MyOracleConnection = Nothing

                        myODBCConnection.ConnectionString = WebConfigurationManager.ConnectionStrings("DeltaConnection").ConnectionString
                        myODBCConnection.Open()

                        Dim myCommand As New OdbcCommand(MyDBAction.ToString, myODBCConnection)
                        Dim ScalarItem As Object = myCommand.ExecuteScalar

                    Case DBActionType.ODBCDataTable '  10

                        MyOracleConnection = Nothing

                        myODBCConnection.ConnectionString = WebConfigurationManager.ConnectionStrings("DeltaConnection").ConnectionString
                        myODBCConnection.Open()

                        Dim MyAdpater As New OdbcDataAdapter(MyDBAction.ToString, myODBCConnection)
                        Dim MyDataTable As New Data.DataTable
                        MyAdpater.Fill(MyDataTable)

                        Return MyDataTable

                    Case DBActionType.OracleScalar

                        myODBCConnection = Nothing

                        myConnection.Close()

                        DecryptedStr = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("IMALConnection").ConnectionString)

                        MyOracleConnection.ConnectionString = DecryptedStr
                        MyOracleConnection.Open()

                        Dim myOracleCommand As New OracleCommand(MyDBAction.ToString, MyOracleConnection)
                        Dim ScalarItem As Object = myOracleCommand.ExecuteScalar

                        MyOracleConnection.Close()

                        Return ScalarItem

                    Case DBActionType.OracleDataReader
                        myODBCConnection = Nothing

                        myConnection.Close()

                        DecryptedStr = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("IMALConnection").ConnectionString)

                        MyOracleConnection.ConnectionString = DecryptedStr

                        MyOracleConnection.Open()

                        'Dim MyODBCAdapter As New OdbcDataAdapter(MyDBAction.ToString, myODBCConnection)
                        'Dim MyDataTable As New Data.DataTable
                        'MyODBCAdapter.Fill(MyDataTable)
                        'myODBCConnection.Close()

                        Dim myOracleCommand As New OracleCommand(MyDBAction.ToString, MyOracleConnection)
                        MyOracleReaderReader = myOracleCommand.ExecuteReader(Data.CommandBehavior.CloseConnection)

                        Return MyOracleReaderReader

                    Case DBActionType.OracleDataTable
                        myODBCConnection = Nothing

                        myConnection.Close()

                        DecryptedStr = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("IMALConnection").ConnectionString)

                        MyOracleConnection.ConnectionString = DecryptedStr

                        MyOracleConnection.Open()

                        Dim MyOracleAdpater As New OracleDataAdapter(MyDBAction.ToString, MyOracleConnection)
                        Dim MyDataTable As New Data.DataTable
                        MyOracleAdpater.Fill(MyDataTable)

                        Return MyDataTable


                End Select

            Catch ex As Exception


            Finally

                If Not IsNothing(MyReader) OrElse Not IsNothing(MyReaderODBC) OrElse Not IsNothing(MyOracleReaderReader) Then

                ElseIf myConnection.State <> Data.ConnectionState.Closed AndAlso IsNothing(MyReader) Then
                    myConnection.Close()
                    myConnection.Dispose()

                ElseIf myConnection.State <> Data.ConnectionState.Closed AndAlso IsNothing(MyReaderODBC) Then
                    myConnection.Close()
                    myConnection.Dispose()

                ElseIf Not IsNothing(myODBCConnection) AndAlso IsNothing(MyReaderODBC) Then
                    myODBCConnection.Close()
                    myODBCConnection.Dispose()

                    myConnection.Close()
                    myConnection.Dispose()

                ElseIf Not IsNothing(MyOracleConnection) AndAlso IsNothing(MyOracleReaderReader) Then
                    MyOracleConnection.Close()
                    MyOracleConnection.Dispose()

                    MyOracleConnection.Close()
                    MyOracleConnection.Dispose()
                Else

                    If myConnection.State <> Data.ConnectionState.Closed Then
                        myConnection.Close()
                    End If
                    myConnection.Dispose()

                End If



            End Try


        End Function

        Public Function AddSystemSettings(ByVal LoginFromEmail As String, ByVal LoginDisplayName As String, _
        ByVal LoginSubject As String, ByVal EmailServer As String, ByVal EmailUserName As String, _
        ByVal EmailPassword As String, ByVal AddedBy As String, ByVal AddedOn As DateTime, _
        ByVal LastUpdatedBy As String, ByVal LastUpdatedOn As DateTime, ByVal TransactionsNotification As String, ByVal OwnAccounts As String, _
        ByVal GABAccounts As String, ByVal LocalBanks As String, ByVal International As String, ByVal UtilityPayments As String, ByVal Salaries As String, _
        ByVal Suppliers As String, ByVal RTGS As String, ByVal SO As String, ByVal LC As String, ByVal StopCheque As String, _
        ByVal BankersCheques As String, ByVal ChequeBooks As String, ByVal ATMCards As String) As Int32

            Dim EnctryptionAlgorith As String = "rijndael"
            Dim CryptographyFactory As New FinpayiSecurity.CryptoFactory()
            Dim Cryptographer As FinpayiSecurity.ICrypto = CryptographyFactory.MakeCryptographer(EnctryptionAlgorith)

            Dim DecryptedStr As String = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("FINMIS3").ConnectionString)

            Dim myConnection As New SqlConnection(DecryptedStr)
            myConnection.Open()

            Dim myCommand As New SqlCommand("Add_SystemSettings", myConnection)


            With myCommand
                .CommandType = Data.CommandType.StoredProcedure
                .Parameters.Add("@LoginFromEmail", Data.SqlDbType.VarChar, 200).Value = LoginFromEmail
                .Parameters.Add("@LoginDisplayName", Data.SqlDbType.VarChar, 200).Value = LoginDisplayName
                .Parameters.Add("@LoginSubject", Data.SqlDbType.VarChar, 500).Value = LoginSubject
                .Parameters.Add("@EmailServer", Data.SqlDbType.VarChar, 200).Value = EmailServer
                .Parameters.Add("@EmailUserName", Data.SqlDbType.VarChar, 200).Value = EmailUserName
                .Parameters.Add("@EmailPassword", Data.SqlDbType.VarChar, 200).Value = EmailPassword
                .Parameters.Add("@TransactionsNotification", Data.SqlDbType.VarChar, 200).Value = TransactionsNotification
                ''.Parameters.Add("@CBOGroupEmail", Data.SqlDbType.VarChar, 200).Value = CBOGroupEmail
                .Parameters.Add("@AddedBy", Data.SqlDbType.VarChar, 200).Value = AddedBy
                .Parameters.Add("@AddedOn", Data.SqlDbType.DateTime).Value = AddedOn
                .Parameters.Add("@LastUpdatedBy", Data.SqlDbType.VarChar, 200).Value = LastUpdatedBy
                .Parameters.Add("@LastUpdatedOn", Data.SqlDbType.DateTime).Value = LastUpdatedOn

                .Parameters.Add("@OwnAccounts", Data.SqlDbType.VarChar, 200).Value = OwnAccounts
                .Parameters.Add("@GABAccounts", Data.SqlDbType.VarChar, 200).Value = GABAccounts
                .Parameters.Add("@LocalBanks", Data.SqlDbType.VarChar, 200).Value = LocalBanks
                .Parameters.Add("@International", Data.SqlDbType.VarChar, 200).Value = International
                .Parameters.Add("@UtilityPayments", Data.SqlDbType.VarChar, 200).Value = UtilityPayments
                .Parameters.Add("@Salaries", Data.SqlDbType.VarChar, 200).Value = Salaries
                .Parameters.Add("@Suppliers", Data.SqlDbType.VarChar, 200).Value = Suppliers
                .Parameters.Add("@RTGS", Data.SqlDbType.VarChar, 200).Value = RTGS
                .Parameters.Add("@SO", Data.SqlDbType.VarChar, 200).Value = SO
                .Parameters.Add("@LC", Data.SqlDbType.VarChar, 200).Value = LC
                .Parameters.Add("@StopCheque", Data.SqlDbType.VarChar, 200).Value = StopCheque
                .Parameters.Add("@BankersCheques", Data.SqlDbType.VarChar, 200).Value = BankersCheques
                .Parameters.Add("@ChequeBooks", Data.SqlDbType.VarChar, 200).Value = ChequeBooks
                .Parameters.Add("@ATMCards", Data.SqlDbType.VarChar, 200).Value = ATMCards

                .ExecuteNonQuery()

            End With

            myConnection.Close()

        End Function

        Public Function AddUtility(ByVal strUtilityCode As String, ByVal strUtilityName As String, ByVal strUtilityAbbr As String) As Integer
            Dim myUtilityId As Int32 = 0
            Dim sqlstring As String = ""

            Dim EnctryptionAlgorith As String = "rijndael"
            Dim CryptographyFactory As New FinpayiSecurity.CryptoFactory()
            Dim Cryptographer As FinpayiSecurity.ICrypto = CryptographyFactory.MakeCryptographer(EnctryptionAlgorith)

            Dim DecryptedStr As String = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("FINMIS3").ConnectionString)

            Dim myConnection As New SqlConnection(DecryptedStr)

            myConnection.Open()

            Dim myCommand As New SqlCommand("Add_Utility", myConnection)

            With myCommand
                .CommandType = Data.CommandType.StoredProcedure
                .Parameters.Add("@UtilityID", Data.SqlDbType.Int, 4).Direction = Data.ParameterDirection.Output

                .Parameters.Add("@UtilityCode", Data.SqlDbType.VarChar, 100).Value = strUtilityCode
                .Parameters.Add("@UtilityName", Data.SqlDbType.VarChar, 200).Value = strUtilityName
                .Parameters.Add("@ABBREVIATION", Data.SqlDbType.VarChar, 200).Value = strUtilityAbbr
                .ExecuteNonQuery()
                myUtilityId = .Parameters.Item("@UtilityID").Value.ToString
            End With

            myConnection.Close()
            '
            Return CInt(myUtilityId)
        End Function


        Public Function AddProfile(ByVal strProfileName As String, ByVal strProfileType As String, ByVal strRemarks As String) As Int32
            Dim MyProfileID As Int32 = 0
            Dim sqlstring As String = ""

            Dim EnctryptionAlgorith As String = "rijndael"
            Dim CryptographyFactory As New FinpayiSecurity.CryptoFactory()
            Dim Cryptographer As FinpayiSecurity.ICrypto = CryptographyFactory.MakeCryptographer(EnctryptionAlgorith)

            Dim DecryptedStr As String = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("FINMIS3").ConnectionString)

            Dim myConnection As New SqlConnection(DecryptedStr)
            myConnection.Open()

            Dim myCommand As New SqlCommand("Add_Profile", myConnection)

            With myCommand
                .CommandType = Data.CommandType.StoredProcedure
                .Parameters.Add("@ProfileID", Data.SqlDbType.Int, 4).Direction = Data.ParameterDirection.Output
                .Parameters.Add("@PROFILENAME", Data.SqlDbType.VarChar, 100).Value = strProfileName
                .Parameters.Add("@PROFILETYPE", Data.SqlDbType.VarChar, 200).Value = strProfileType
                .Parameters.Add("@REMARKS", Data.SqlDbType.VarChar, 200).Value = strRemarks
                .ExecuteNonQuery()
                MyProfileID = .Parameters.Item("@ProfileID").Value.ToString
            End With

            myConnection.Close()
            Return CInt(MyProfileID)

        End Function
        Public Function AddCurrrency(ByVal strCurrencyCode As String, ByVal StrCurrencyName As String, ByVal strRemarks As String) As Int32
            Dim MyCurrencyID As Int32 = 0
            Dim sqlstring As String = ""

            Dim EnctryptionAlgorith As String = "rijndael"
            Dim CryptographyFactory As New FinpayiSecurity.CryptoFactory()
            Dim Cryptographer As FinpayiSecurity.ICrypto = CryptographyFactory.MakeCryptographer(EnctryptionAlgorith)

            Dim DecryptedStr As String = Cryptographer.Decrypt(WebConfigurationManager.ConnectionStrings("FINMIS3").ConnectionString)

            Dim myConnection As New SqlConnection(DecryptedStr)
            myConnection.Open()

            Dim myCommand As New SqlCommand("Add_Currency", myConnection)

            With myCommand
