    Public Sub GenerateHeaders()
        If isBookOpen = True Then
            Dim Details As Microsoft.Office.Interop.Excel.Worksheet = _Book.Sheets(2)
            Dim Master As Microsoft.Office.Interop.Excel.Worksheet = _Book.Sheets(1)

            With Master.Cells

                'clear all data
                .Clear()

                'Row 1
                .Item(1, 1) = "DETB_UPLOAD_MASTER"
                .Item(1, 2) = "~~END~~"

                'Row 2
                .Item(2, 1) = "BRANCH_CODE"
                .Item(2, 2) = "SOURCE_CODE"
                .Item(2, 3) = "BATCH_NO"
                .Item(2, 4) = "AUTO_AUTH"
                .Item(2, 5) = "BALANCING"
                .Item(2, 6) = "ONCE_AUTH"
                .Item(2, 7) = "USER_ID"
                .Item(2, 8) = "MAKER_ID"
                .Item(2, 9) = "MAKER_DT_STAMP"
                .Item(2, 10) = "RECORDSTAT"
                .Item(2, 11) = "BATCH_DESC"
                .Item(2, 12) = "~~END~~"
            End With
            With Details.Cells
                'clear all data
                .Clear()
                'Row 1
                .Item(1, 1) = "DETB_UPLOAD_DETAIL"
                .Item(1, 2) = "~~END~~"
                'Row 2
                .Item(1, 1) = "ACCOUNT_BRANCH"
                .Item(1, 2) = "BRANCH_CODE"
                .Item(1, 3) = "SOURCE_CODE"
                .Item(1, 4) = "BATCH_NO"
                .Item(1, 5) = "CURR_NO"
                .Item(1, 6) = "CCY_CD"
                .Item(1, 7) = "ACCOUNT"
                .Item(1, 8) = "AMOUNT"
                .Item(1, 9) = "LCY_EQUIVALENT"
                .Item(1, 10) = "EXCH_RATE"
                .Item(1, 11) = "DR_CR"
                .Item(1, 12) = "TXN_CODE"
                .Item(1, 13) = "VALUE_DATE"
                .Item(1, 14) = "FIN_CYCLE"
                .Item(1, 15) = "ADDL_TEXT"
                .Item(1, 16) = "PERIOD_CODE"
                .Item(1, 17) = "INSTRUMENT_NO"
                .Item(1, 18) = "~~END~~"

            End With


            isHeaderGenerated = True
        Else
            isHeaderGenerated = False
        End If
    End Sub
    Public Sub GenerateFooters()
        If isBookOpen = True Then
            Dim Details As Microsoft.Office.Interop.Excel.Worksheet = _Book.Sheets(2)
