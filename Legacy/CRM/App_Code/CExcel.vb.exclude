    End Sub
    Public Function GenerateTable(ByVal conn_string As String) As Data.DataTable
        Dim sql As New Data.SqlClient.SqlDataAdapter(conn_string, "Data Source=DIT-SNJAU;Initial Catalog=AfroFinPay2;User ID=sa")
        Dim ds As New Data.DataSet
        sql.Fill(ds, "TB")
        Return ds.Tables("TB")
    End Function
    Public Sub CloseWorkBook()
        If isBookOpen = True Then
            _Book.Close()
            _Book = Nothing
            isBookOpen = False
        End If
    End Sub
End Class
