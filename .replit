modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
MSSQL_ENCRYPT = "false"
MSSQL_HOST = "0.tcp.in.ngrok.io"
MSSQL_TRUST_SERVER_CERT = "true"
MSSQL_PORT = "22741"

[nix]
channel = "stable-25_05"
