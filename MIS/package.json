{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "local:init": "node scripts/src/local-dev.mjs init",
    "local:check": "node scripts/src/local-dev.mjs check",
    "local:build": "node scripts/src/local-dev.mjs build",
    "local:dev": "node scripts/src/local-dev.mjs dev",
    "local:debug": "node scripts/src/local-dev.mjs debug",
    "local:mail": "node scripts/src/local-dev.mjs mail",
    "local:db:init": "node scripts/src/local-dev.mjs db-init",
    "local:db:admin": "node scripts/src/local-dev.mjs db-admin",
    "local:db:metadata": "node scripts/src/local-dev.mjs db-metadata",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
